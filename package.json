{
  "name": "practical-12-ci-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "Practical 12: CI/CD Pipeline with GitHub Actions and Automated Testing",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest tests/tasks.test.js --runInBand --detectOpenHandles --forceExit",
    "test:all": "jest --runInBand --detectOpenHandles --forceExit",
    "test:fail-demo": "jest tests/broken.test.js --runInBand",
    "lint": "node --check app.js && node --check server.js && node --check tests/tasks.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 10000
  }
}
